    "pg": "^8.20.0",
    "redis": "^4.6.14"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.13",
    "@types/pg": "^8.11.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.4.5",
    "vite-node": "^1.6.0",
    "vitest": "^1.3.1"
