{
  "name": "editor-chain-proxy",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11.x" },
  "description": "Dev-only ethers-as-a-service HTTP proxy for the Unity Editor (testnet only, localhost only). Never deploy to production.",
  "scripts": {
    "dev": "vite-node src/Server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "dev:release": "npm run build && node dist/Server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "ethers": "^6.13.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3",
    "vite-node": "^2.1.8"
  }
}
