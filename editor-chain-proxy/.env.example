# editor-chain-proxy — dev-only, testnet-only. Copy to .env if you need to override.
PORT=8555

# Bind address. Leave as loopback for a bare `npm start`. Docker sets HOST=0.0.0.0
# (compose.yaml) and publishes the port to 127.0.0.1 only, so it stays local either way.
# HOST=127.0.0.1

# Optional RPC overrides (still guarded: the proxy rejects any RPC whose real
# chainId is not a whitelisted testnet — 97 bsctestnet, 80002 amoy).
# BSCTESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
# AMOY_RPC=https://rpc-amoy.polygon.technology/

# DepositNative proxy address per testnet — set after deploy-deposit-native.js runs.
# Overrides the (empty) NATIVE_REGISTRY in src/game/addresses.ts; without it the
# NATIVE_* commands return a clear 400.
# NATIVE_BSCTESTNET=0x...
# NATIVE_AMOY=0x...
