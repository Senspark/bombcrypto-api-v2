PORT=8110
IS_PROD=false

# Google Sign-In gate. Off when false: every request is treated as an authenticated local operator.
IS_GCLOUD=false
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=senspark.com
SESSION_TTL_SECONDS=43200

REDIS_CONNECTION_STRING=redis://localhost:6379

# Read-only DSN for the game database, used for the DepositNative reporting. Leave empty to run
# without it; the schedule tabs are unaffected. The uids left out of the figures are configured at
# runtime through PUT /treasury/native/excluded-uids, not here.
DATABASE_URL=
NATIVE_STATS_TTL_SECONDS=60
SNAPSHOT_TIMEZONE=Asia/Bangkok

# Manager EOA holding WITHDRAWER_ROLE on the six treasury proxies. Needs BNB and POL for gas.
MANAGER_PRIVATE_KEY=

BSC_RPC=https://bsc-dataseed.binance.org
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com

TICK_INTERVAL_MS=30000
MIN_NATIVE_BALANCE=0.005
