{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Node",
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "esModuleInterop": true,
        "baseUrl": "./src",
        "outDir": "./dist",
        "typeRoots": ["./node_modules/@types"],
        "alwaysStrict": true,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "allowUnreachableCode": false,
        "resolveJsonModule": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["./src"],
    "tsc-alias": {
        "resolveFullPaths": true
    }
}
