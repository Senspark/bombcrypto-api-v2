{
    "name": "treasury-manager",
    "version": "1.0.0",
    "description": "Scheduled swapToUSDT runner for Market and BHeroS treasuries",
    "type": "module",
    "engines": {
        "node": ">=20.11.x"
    },
    "scripts": {
        "start": "tsc --noEmit && npx vite-node src/Server.ts",
        "build": "tsc && tsc-alias",
        "start:release": "npm run build && node dist/Server.js"
    },
    "overrides": {
        "@pancakeswap/swap-sdk-core": "1.2.0"
    },
    "dependencies": {
        "@pancakeswap/chains": "0.4.6",
        "@pancakeswap/sdk": "5.8.8",
        "@pancakeswap/smart-router": "6.1.6",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.4.5",
        "envalid": "^8.0.0",
        "ethers": "^6.13.5",
        "express": "^4.19.2",
        "google-auth-library": "^9.14.1",
        "redis": "^4.6.14",
        "viem": "^2.55.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "tsc-alias": "^1.8.10",
        "typescript": "^5.4.5",
        "vite-node": "^1.6.0"
    }
}
