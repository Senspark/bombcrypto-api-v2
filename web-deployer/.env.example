# The two roles share this file in local development. In production they are two
# containers and only the receiver ever sees WEBHOOK_SECRET_* or SLACK_WEBHOOK_URL.

# --- Both ---
SITES_FILE=/config/sites.json

# --- Receiver ---
PORT=8111
BUILDER_URL=http://ap-web-builder:80
BUILDER_TIMEOUT_MS=10000
POLL_INTERVAL_MS=5000

# `npm run keygen` prints a fresh pair. The private half stays here; the public
# half is the only one the builder gets.
TRIGGER_PRIVATE_KEY=

# One per site in sites.json: WEBHOOK_SECRET_<NAME>, name uppercased, dashes as
# underscores. Must match the secret set on the GitHub webhook, which must
# deliver both push and issue_comment events.
WEBHOOK_SECRET_EXAMPLE_SITE=change-me

# Optional. Leave empty to run without notifications.
SLACK_WEBHOOK_URL=
# Optional. Linked at the bottom of each notification.
DASHBOARD_URL=

# Google OAuth 2.0 Web client id. Empty turns authentication off entirely and
# leaves rollback open to anyone who can reach the dashboard - local
# development only. ALLOWED_EMAIL_DOMAIN is the Workspace domain (hd claim) that
# may sign in, and is required whenever GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=
SESSION_TTL_SECONDS=43200

# off | log | enforce. Restricts /api/hooks to GitHub's published addresses,
# read from CF-Connecting-IP. Start in log and watch what it would have rejected.
HOOK_IP_MODE=log

# --- Builder ---
# PORT=8112
REPOS_DIR=/data/repos
LOGS_DIR=/data/logs
STATE_FILE=/data/logs/state.json
# Every published version is archived here so a rollback restores the exact bytes
# that were live, without rebuilding. Kept per site, oldest pruned first.
BACKUP_DIR=/data/backup
BACKUP_KEEP=10
TRIGGER_PUBLIC_KEY=
TRIGGER_MAX_AGE_MS=60000

HISTORY_LIMIT=20
GIT_TIMEOUT_MS=300000
BUILD_TIMEOUT_MS=900000
PUBLISH_TIMEOUT_MS=300000
LOG_TAIL_LINES=20
